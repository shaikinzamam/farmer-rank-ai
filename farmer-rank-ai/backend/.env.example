# ---- Server ----
PORT=4000
NODE_ENV=development
JWT_SECRET=change-me-super-secret

# ---- LLM (Grok / xAI, OpenAI-compatible chat completions API) ----
GROK_API_KEY=
GROK_BASE_URL=https://api.x.ai/v1
GROK_MODEL=grok-2-latest
# Fallback provider if Grok is down (circuit breaker fallback)
FALLBACK_LLM_PROVIDER=openai
OPENAI_API_KEY=

# ---- Qdrant ----
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION_FARMERS=farmer_listings
QDRANT_COLLECTION_MEMORY=interaction_memory
EMBEDDING_DIM=384

# ---- Enkrypt AI Safety ----
ENKRYPT_API_KEY=
ENKRYPT_BASE_URL=https://api.enkryptai.com
ENKRYPT_DEPLOYMENT_NAME=farmer-rank-ai-guardrails

# ---- PostgreSQL / Supabase ----
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/farmer_rank_ai

# ---- Redis (response cache) ----
REDIS_URL=redis://localhost:6379

# ---- Observability ----
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com


FEATHERLESS_API_KEY=
FEATHERLESS_BASE_URL=https://api.featherless.ai/v1
FEATHERLESS_MODEL=deepseek-ai/DeepSeek-V3-0324
LLM_PROVIDER=featherless